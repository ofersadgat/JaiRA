{
  "label": "Say hello",
  "outputs": {
    "greeting": {
      "binding": ".operation.output.greeting"
    }
  },
  "operation": {
    "prompt": "Reply with exactly this and nothing else: Hello, world!",
    "output": {
      "greeting": {
        "schema": {
          "type": "string"
        }
      }
    }
  }
}
