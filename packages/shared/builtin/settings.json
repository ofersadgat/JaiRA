{
  "models": {
    "presets": {
      "simple": {
        "model": { "candidates": ["claude-haiku-4-5", "gpt-5.6-luna"], "choose": "first-available" }
      },
      "coder": {
        "model": { "candidates": ["claude-opus-5-5", "gpt-5.6-terra"], "choose": "most-left" },
        "reasoning": { "effort": "high" }
      },
      "planner": {
        "model": { "candidates": ["claude-fable-5-1", "gpt-5.6-sol"], "choose": "most-left" },
        "reasoning": { "effort": "high" }
      },
      "agent": {
        "model": {
          "candidates": ["claude-code/default", "claude-cli/default", "codex-cli/default", "opencode/default"],
          "choose": "first-available"
        }
      }
    }
  },
  "agents": {
    "genericCli": [
      {
        "name": "gemini-cli",
        "command": "gemini",
        "args": ["--approval-mode", "auto_edit", "-p", "{prompt}"],
        "mcp": {
          "args": ["--allowed-mcp-server-names", "dai"],
          "env": { "GEMINI_CLI_SYSTEM_SETTINGS_PATH": "{mcpConfig}" },
          "config": {
            "mcpServers": { "dai": { "httpUrl": "{mcpUrl}", "trust": true, "timeout": 86400000 } },
            "tools": { "core": ["mcp_dai_*"] }
          },
          "configName": "settings.json",
          "builtinsOff": true
        }
      },
      { "name": "antigravity-cli", "command": "agy", "args": ["--mode", "accept-edits", "-p", "{prompt}"] },
      { "name": "muse-code", "command": "muse", "args": ["exec", "--approval-mode", "never"] },
      {
        "name": "opencode",
        "command": "opencode",
        "args": ["run"],
        "mcp": {
          "args": ["--agent", "jaira"],
          "env": {
            "OPENCODE_CONFIG": "{mcpConfig}",
            "OPENCODE_DISABLE_PROJECT_CONFIG": "1",
            "OPENCODE_PERMISSION": "{\"*\":\"deny\",\"dai_*\":\"allow\"}"
          },
          "config": {
            "$schema": "https://opencode.ai/config.json",
            "mcp": { "dai": { "type": "remote", "url": "{mcpUrl}", "oauth": false, "timeout": 86400000 } },
            "agent": {
              "jaira": { "mode": "primary", "description": "Works only through the tools JaiRA serves it.", "permission": { "*": "deny", "dai_*": "allow" } }
            }
          },
          "configName": "opencode.json",
          "builtinsOff": true
        }
      }
    ]
  },
  "functions": {
    "smart": { "model": "simple" }
  },
  "events": {
    "git.pushed": { "enabled": true },
    "git.merged": { "enabled": true },
    "merge_request.opened": { "enabled": true },
    "merge_request.updated": { "enabled": true },
    "merge_request.pushed": { "enabled": true },
    "merge_request.commented": { "enabled": true },
    "merge_request.merged": { "enabled": true },
    "merge_request.closed": { "enabled": true },
    "pipeline.succeeded": { "enabled": true },
    "pipeline.failed": { "enabled": true },
    "pipeline.canceled": { "enabled": true },
    "task.finished": { "enabled": true },
    "task.failed": { "enabled": true }
  }
}
