{
  "description": "Refuses what destroys work: rewriting or force-pushing git history, deleting .git, untracked processes.",
  "git push --force": "deny",
  "git push -f": "deny",
  "git push --force-with-lease": "deny",
  "git push --mirror": "deny",
  "git reset --hard": "deny",
  "git rebase": "deny",
  "git filter-branch": "deny",
  "git filter-repo": "deny",
  "git gc": "deny",
  "git prune": "deny",
  "git clean -f": "deny",
  "git clean --force": "deny",
  "rm -r": {"**/.git": "deny", "**/.git/**": "deny"},
  "rm -R": {"**/.git": "deny", "**/.git/**": "deny"},
  "rm --recursive": {"**/.git": "deny", "**/.git/**": "deny"},
  "remove-item -recurse": {"**/.git": "deny", "**/.git/**": "deny"},
  "rd": {"**/.git": "deny", "**/.git/**": "deny"},
  "rmdir": {"**/.git": "deny", "**/.git/**": "deny"},
  "del": {"**/.git": "deny", "**/.git/**": "deny"},
  "erase": {"**/.git": "deny", "**/.git/**": "deny"},
  "shell --untracked": "deny"
}
