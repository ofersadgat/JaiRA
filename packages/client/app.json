{
  "expo": {
    "name": "JaiRA",
    "slug": "jaira",
    "scheme": "jaira",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mistlabs.jaira",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "JaiRA looks on your Wi-Fi for a JaiRA machine showing a pairing code, to pair with it.",
        "NSBonjourServices": ["_jaira._tcp"]
      }
    },
    "android": {
      "package": "com.mistlabs.jaira"
    },
    "plugins": [
      "./plugins/withWorkspaceReactNative.cjs",
      "one/expo-plugin",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withIslands.cjs",
      "./plugins/withBundledFonts.cjs"
    ]
  }
}
