{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The client runs in Chromium (Electron, a browser) and, from S3, React Native.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    // The base's paths, relative to it, plus `@jaira/ui`: today's renderer where it stands (0013, S1).
    "paths": {
      "@jaira/ui/*": ["./packages/app/src/renderer/*"],
      "@jaira/shared/browser": ["./packages/shared/src/browser.ts"],
      "@jaira/shared": ["./packages/shared/src/index.ts"]
    }
  },
  // The renderer's ambient declarations (Vite's `?worker`, Monaco's untyped entries) travel with it.
  "include": ["app/**/*.ts", "app/**/*.tsx", "bridges/**/*.ts", "vite.config.ts", "../app/src/renderer/*.d.ts"]
}
