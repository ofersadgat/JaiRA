{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The client runs in Chromium (Electron, a browser) and, from S3, React Native.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    // Relative to THIS folder, not the repository root the base config uses: One's Metro preset turns
    // these paths into module-resolver aliases resolved against the project folder and ignores
    // `baseUrl` (1.27.1), so `./packages/universal/…` became packages/client/packages/…. TypeScript reads
    // both forms the same. `@jaira/ui` is today's renderer where it stands (0013, S1).
    "baseUrl": ".",
    "paths": {
      "@jaira/ui/*": ["../app/src/renderer/*"],
      "@jaira/universal": ["../universal/src/index.ts"],
      "@jaira/shared/browser": ["../shared/src/browser.ts"],
      "@jaira/shared": ["../shared/src/index.ts"]
    }
  },
  // The renderer's ambient declarations (Vite's `?worker`, Monaco's untyped entries) travel with it.
  "include": ["app/**/*.ts", "app/**/*.tsx", "bridges/**/*.ts", "src/**/*.tsx", "island/**/*.ts", "island/**/*.tsx", "vite.config.ts", "../app/src/renderer/*.d.ts"]
}
