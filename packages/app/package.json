{
  "name": "@jaira/app",
  "version": "0.1.0",
  "description": "JaiRA desktop app (Electron): the board, the session view, and the approval queue.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofersadgat/JaiRA.git",
    "directory": "packages/app"
  },
  "type": "module",
  "main": "entry.cjs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:main": "node build.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && npm run abi:electron && electron .",
    "abi:electron": "node ../../scripts/nativeAbi.mjs electron",
    "abi:node": "node ../../scripts/nativeAbi.mjs node",
    "shots": "tsx shots/run.mts",
    "shots:logs": "tsx shots/logs.mts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@declarative-ai/exec": "file:../../../declarative-ai/packages/exec",
    "@declarative-ai/hw": "file:../../../declarative-ai/packages/hw",
    "@declarative-ai/json": "file:../../../declarative-ai/packages/json",
    "@declarative-ai/llm": "file:../../../declarative-ai/packages/llm",
    "@declarative-ai/log": "file:../../../declarative-ai/packages/log",
    "@jaira/persistence": "*",
    "@jaira/runtime": "*",
    "@jaira/shared": "*",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@shikijs/monaco": "^4.4.3",
    "ajv": "^8.20.0",
    "markdown-it": "^15.0.0",
    "monaco-editor": "^0.56.0",
    "node-llama-cpp": "^3.21.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.4.3",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "vite": "^6.0.5"
  }
}
