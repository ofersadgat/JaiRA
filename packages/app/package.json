{
  "name": "@jaira/app",
  "version": "0.1.0",
  "description": "JaiRA desktop app (Electron): the board, the session view, and the approval queue.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofersadgat/JaiRA.git",
    "directory": "packages/app"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:main": "node build.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && npm run abi:electron && electron .",
    "abi:electron": "node ../../scripts/nativeAbi.mjs electron",
    "abi:node": "node ../../scripts/nativeAbi.mjs node"
  },
  "dependencies": {
    "@declarative-ai/exec": "file:../../../declarative-ai/packages/exec",
    "@declarative-ai/hw": "file:../../../declarative-ai/packages/hw",
    "@declarative-ai/json": "file:../../../declarative-ai/packages/json",
    "@jaira/persistence": "*",
    "@jaira/runtime": "*",
    "@jaira/shared": "*",
    "ajv": "^8.20.0",
    "dompurify": "^3.4.13",
    "markdown-it": "^15.0.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "vite": "^6.0.5"
  }
}
