{
  "name": "@jaira/universal",
  "version": "0.1.0",
  "description": "JaiRA's universal tree (decision 0015): Tamagui copies of the renderer's components, for web and native.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs"
  },
  "dependencies": {
    "@tamagui/core": "~2.7.7",
    "expo-clipboard": "57.0.2",
    "expo-file-system": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  }
}
