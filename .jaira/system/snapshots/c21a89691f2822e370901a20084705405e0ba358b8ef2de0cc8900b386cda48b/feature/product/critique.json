                },
                "evidence": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string"
                }
              }
            }
          },
          "max_severity": {
            "type": "string",
            "enum": [
              "blocker",
              "significant",
              "minor",
              "note"
            ]
          },
          "max_severity_rank": {
            "type": "integer"
          },
          "target": {
            "type": "string",
            "enum": [
              "draft",
              "explore",
              "upstream",
              "ask"
            ]
          }
        },
        "required": [
          "findings",
          "max_severity",
          "max_severity_rank",
          "target"
        ]
      }
