{
  "label": "Conformance pass",
  "inputs": {
    "feature": {
      "kind": "json",
      "schema": {
        "type": "object",
        "required": [
          "id",
          "story",
          "importance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "story": {
            "type": "string"
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doc_path": {
            "type": "string"
          }
        }
      }
    },
    "patterns": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "components": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "units": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "changes": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "tests": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "paths": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "layer_verdicts": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "layer_verdicts"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "layer_verdicts"
    }
  },
  "operation": {
    "kind": "prompt",
    "user": "Check, layer by layer, that what was built matches what that layer's doc says.\n\n## The feature\n\n{{.inputs.feature}}\n\n## What it is built from\n\nPatterns: {{.inputs.patterns}}\n\nComponents: {{.inputs.components}}\n\nUnits: {{.inputs.units}}\n\n## The changes\n\n{{.inputs.changes}}\n\n## The tests\n\n{{.inputs.tests}}\n\n## The docs\n\n{{.inputs.paths}}\n\nOpen each doc and the code it names. For each layer, record `conforms`, `departs` with the evidence, or `unverified` when nothing could be checked. A row that says nothing was checked is not a pass.\n\n## What to produce\n\n`layer_verdicts`: one row per layer: `{ layer, verdict, evidence }`.\n",
    "config": {
      "model": "claude-opus-5"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "layer_verdicts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "layer_verdicts"
        ]
      }
    }
  },
  "environment": {
    "tools": [
      "read_file",
      "glob",
      "grep",
      "web_fetch",
      "web_search"
    ],
    "permissions": {
      "tools": {
        "read_file": "allow",
        "glob": "ask",
        "grep": "ask",
        "web_fetch": "ask",
        "web_search": "ask",
        "jaira:toolset+": "allow",
        "jaira:toolset-": "deny"
      },
      "other": "deny",
      "functions": {},
      "implementations": {}
    }
  },
  "slotMeta": {
    "inputs.patterns": {
      "optional": true,
      "description": "The patterns this feature uses, reused and new alike."
    },
    "inputs.components": {
      "optional": true,
      "description": "The components this feature uses, reused and new alike."
    },
    "inputs.units": {
      "optional": true,
      "description": "The units this feature uses, reused and new alike."
    },
    "inputs.changes": {
      "optional": true
    },
    "inputs.tests": {
      "optional": true
    },
    "inputs.paths": {
      "optional": true
    }
  }
}
