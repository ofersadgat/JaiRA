{
  "label": "Disposition",
  "inputs": {
    "feature": {
      "kind": "json",
      "schema": {
        "type": "object",
        "required": [
          "id",
          "story",
          "importance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "story": {
            "type": "string"
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doc_path": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "tests": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "outputs": {
    "disposition": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "disposition"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "disposition"
    },
    "shipped": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "shipped"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "shipped"
    }
  },
  "operation": {
    "kind": "prompt",
    "user": "Recommend a disposition for this feature.\n\n## The feature\n\n{{.inputs.feature}}\n\n## The findings\n\n{{.inputs.findings}}\n\n## The tests\n\n{{.inputs.tests}}\n\n`ship` when no blocker remains and the tests defend the story. `revise` when a blocker names a layer that can fix it. `drop` when the feature cannot deliver its value as specified.\n\n## What to produce\n\n`disposition`: `ship`, `revise` or `drop`.\n\n`shipped`: the feature id when the disposition is ship; empty otherwise.\n",
    "config": {
      "model": "claude-opus-5"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "disposition": {
            "type": "string",
            "enum": [
              "ship",
              "revise",
              "drop"
            ]
          },
          "shipped": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "disposition",
          "shipped"
        ]
      }
    }
  },
  "slotMeta": {
    "inputs.tests": {
      "optional": true
    }
  }
}
