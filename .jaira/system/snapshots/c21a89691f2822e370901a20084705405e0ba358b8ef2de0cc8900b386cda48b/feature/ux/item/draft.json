  "operation": {
    "kind": "prompt",
    "user": "{{.inputs.prompt}}",
    "config": {
      "model": "claude-opus-5"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "doc": {
            "type": "string",
            "contentMediaType": "text/markdown"
          },
          "doc_path": {
            "type": "string"
          },
          "standing_amendment": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "question",
                "options"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "header": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "value"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                },
                "default": {
                  "type": "string"
                },
                "custom": {
                  "type": "boolean"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            }
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "claim",
                "disposition"
              ],
              "properties": {
                "severity": {
                  "type": "string"
                },
                "claim": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string"
                },
                "disposition": {
                  "type": "string",
                  "enum": [
                    "fixed",
                    "rejected",
                    "blocked"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "doc",
          "doc_path",
          "standing_amendment",
          "questions",
          "responses"
        ]
      }
    }
  },
  "environment": {
    "session": {
      "$ref": "ux-item",
      "$in": "feature/ux/item"
    },
    "tools": [
      "read_file",
      "glob",
      "grep",
      "web_fetch",
      "web_search"
    ],
    "permissions": {
      "tools": {
        "read_file": "allow",
        "glob": "ask",
        "grep": "ask",
        "web_fetch": "ask",
        "web_search": "ask",
        "jaira:toolset+": "allow",
        "jaira:toolset-": "deny"
      },
      "other": "deny",
      "functions": {},
      "implementations": {},
      "scopes": [
        {
          "path": "docs/product/**",
          "tools": {
            "read_file": "allow"
          }
        },
        {
          "path": "docs/ux/**",
          "tools": {
            "read_file": "allow"
          }
        },
        {
          "path": "docs/_templates/**",
          "tools": {
            "read_file": "allow"
          }
        }
      ]
    }
  },
  "scopeSession": {
    "$ref": "ux-item",
    "$in": "feature/ux/item"
  },
  "slotMeta": {
    "outputs.standing_amendment": {
      "optional": true
    },
    "outputs.questions": {
      "optional": true
    },
    "outputs.responses": {
      "optional": true
    }
  },
  "nameBinds": [
    {
      "path": "environment.session",
      "name": "ux-item",
      "in": "feature/ux/item",
      "kind": "session"
    }
  ]
