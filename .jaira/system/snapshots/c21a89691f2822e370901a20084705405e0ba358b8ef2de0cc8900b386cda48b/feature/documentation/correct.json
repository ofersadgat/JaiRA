{
  "label": "Correct what the sweep found",
  "inputs": {
    "stale": {
      "kind": "json",
      "schema": {}
    }
  },
  "outputs": {
    "corrections": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "corrections"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "corrections"
    }
  },
  "operation": {
    "kind": "prompt",
    "user": "Correct the docs the lint found stale.\n\n## The report\n\n{{.inputs.stale}}\n\nOpen each doc named, correct the statement that is stale, and change nothing else.\n\n## What to produce\n\n`corrections`: one row per doc: `{ path, was, now }`.\n",
    "config": {
      "model": "claude-cli/default"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "corrections": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "corrections"
        ]
      }
    }
  },
  "environment": {
    "tools": [
      "read_file",
      "glob",
      "grep",
      "edit",
      "write_file",
      "bash",
      "web_fetch",
      "web_search"
    ],
    "permissions": {
      "tools": {
        "read_file": "allow",
        "glob": "ask",
        "grep": "ask",
        "edit": "ask",
        "write_file": "allow",
        "bash": "ask",
        "web_fetch": "ask",
        "web_search": "ask",
        "jaira:toolset+": "allow",
        "jaira:toolset-": "deny"
      },
      "other": "ask",
      "subjects": {
        "bash": "ask"
      },
      "source": "$/toolsets/feature/write-files",
      "functions": {
        "bash": "smart"
      },
      "implementations": {},
      "scopes": [
        {
          "path": "docs/**",
          "tools": {
            "read_file": "allow",
            "write_file": "allow"
          }
        }
      ]
    }
  },
  "slotMeta": {
    "inputs.stale": {
      "optional": true
    }
  }
}
