{
  "label": "Approve the screens",
  "description": "Always entered (feature.md §0.6). The multi-select over which candidate elements to carry forward is the §0.7 contract amendment; until it lands the question degrades to approve/revise with the elements listed in the comments.",
  "inputs": {
    "docs": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      }
    },
    "mockups": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "ask_below": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "score": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "reasons": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "must_ask": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "decision": {
      "kind": "text",
      "schema": {
        "type": "string",
        "enum": [
          "approve",
          "revise"
        ]
      },
      "name": "decision"
    },
    "comments": {
      "kind": "text",
      "schema": {
        "type": "string"
      },
      "name": "comments"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "review_artifact",
    "input": {
      "prompt": {
        "kind": "text",
        "binding": {
          "text": "These are the component docs and the mockups that realize them — every state, not only the happy one.\n\napprove — engineering plans against these components.\nrevise — back to draft with your comments.\n\nWhere the question is which candidate elements to carry forward, name them in the comments: the multi-select this gate wants is a pending contract amendment (feature.md §0.7)."
        }
      },
      "artifact": {
        "kind": "text",
        "binding": {
          "text": "docs"
        }
      },
      "options": {
        "kind": "json",
        "binding": {
          "json": [
            "approve",
            "revise"
          ]
        }
      },
      "comments": {
        "kind": "json",
        "binding": {
          "json": true
        }
      }
    },
    "output": {
      "name": "output",
      "kind": "json"
    }
  },
  "slotMeta": {
    "inputs.docs": {
      "optional": true
    },
    "inputs.mockups": {
      "optional": true
    },
    "inputs.score": {
      "optional": true
    },
    "inputs.reasons": {
      "optional": true,
      "description": "Shown instead of the bare number: 0.62 tells a person nothing."
    },
    "inputs.must_ask": {
      "optional": true,
      "description": "Non-empty means ask regardless of score."
    },
    "outputs.comments": {
      "optional": true
    }
  }
}
