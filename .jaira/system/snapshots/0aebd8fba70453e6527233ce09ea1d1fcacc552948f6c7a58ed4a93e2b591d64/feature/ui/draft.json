                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "surfaces"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "surfaces"
    },
    "component_docs": {
      "kind": "blob",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
