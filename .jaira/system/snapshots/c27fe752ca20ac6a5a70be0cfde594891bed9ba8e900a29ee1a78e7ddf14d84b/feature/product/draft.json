  "operation": {
    "kind": "prompt",
    "user": "{{.inputs.prompt}}",
    "config": {
      "model": "claude-opus-5"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "story",
                "importance"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "story": {
                  "type": "string"
                },
                "importance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requires": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "related": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "doc_path": {
                  "type": "string"
                }
              }
            }
          },
          "feature_docs": {
            "type": "string",
            "contentMediaType": "text/markdown"
          },
          "doc_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "standing_amendment": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "question",
                "options"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "header": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "value"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                },
                "default": {
                  "type": "string"
                },
                "custom": {
                  "type": "boolean"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            }
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "claim",
                "disposition"
              ],
              "properties": {
                "severity": {
                  "type": "string"
                },
                "claim": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string"
                },
                "disposition": {
                  "type": "string",
                  "enum": [
                    "fixed",
                    "rejected",
                    "blocked"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "features",
          "feature_docs",
          "doc_paths",
          "standing_amendment",
          "questions",
          "responses"
        ]
      }
    }
  },
  "environment": {
    "session": {
      "name": "product-draft",
      "in": "feature/product"
    },
    "tools": [
      "read_file"
    ],
    "permissions": {
      "profile": "read-only",
      "tools": {
        "read_file": "allow"
      },
      "scopes": [
        {
          "path": "docs/product/**",
          "tools": {
            "read_file": "allow"
          }
        },
        {
          "path": "docs/_templates/**",
          "tools": {
            "read_file": "allow"
          }
        }
      ]
    }
  },
  "scopeSession": {
    "name": "product-draft",
    "in": "feature/product"
  },
  "slotMeta": {
    "inputs.prompt": {
      "description": "The turn to append, rendered at the call site."
    },
    "outputs.doc_paths": {
      "optional": true
    },
    "outputs.standing_amendment": {
      "optional": true
    },
    "outputs.questions": {
      "optional": true
    },
    "outputs.responses": {
      "optional": true
    }
  }
}
