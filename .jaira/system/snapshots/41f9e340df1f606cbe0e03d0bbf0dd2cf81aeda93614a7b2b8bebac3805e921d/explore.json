  "sequenceAuthored": false,
  "slotMeta": {
    "inputs.constraint": {
      "description": "What is being decided — the issue, the upstream phase's output, or the paths that describe it."
    },
    "inputs.candidate_kind": {
      "description": "product|ux|ui|engineering|implementation|acceptance|documentation"
    },
    "inputs.varies": {
      "description": "What varies across candidates (framing|path|form|architecture|decomposition|driving|entry-point)."
    },
    "inputs.mandatory_candidate": {
      "description": "The candidate that must be included (e.g. Do nothing, existing pattern unchanged, No new unit)."
    },
    "inputs.guidance": {
      "description": "Paths to what shapes a candidate here. Read them with read_file."
    },
    "inputs.catalog": {
      "description": "Paths to the catalog entries already considered (§0.5 — not an exploration archive)."
    },
    "inputs.prior_findings": {
      "optional": true,
      "description": "When re-entered because target=='explore', prior critique findings appended to the brief."
    },
    "outputs.score": {
      "description": "The winning total; the margins are separate outputs."
    },
    "outputs.mandatory_margin": {
      "optional": true
    },
    "outputs.residue": {
      "description": "The one or two lines written by synthesize onto the doc the phase produced."
    },
    "outputs.runner_up_margin": {
      "optional": true
    },
    "outputs.earlier_phase_finding": {
      "optional": true
    }
  },
  "fanOut": [
    "brief\u0000criteria",
    "candidates\u0000candidates",
    "score\u0000scores"
  ]
}
