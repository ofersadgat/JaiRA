                "type": "number"
              },
              "candidate_id": {
                "type": "string"
              }
            }
          },
          "residue": {
            "type": "object",
            "description": "One or two lines to land on the phase's doc: product='Framings considered'; ux='Where this fits' or new pattern; ui='Instead consider' + winning mockups; engineering=numbered decision record; 5-7=one line on the phase's doc."
          },
          "exploration_doc": {
            "type": "string",
            "contentMediaType": "text/markdown"
          },
          "mandatory_id": {
            "type": "string"
          }
        },
