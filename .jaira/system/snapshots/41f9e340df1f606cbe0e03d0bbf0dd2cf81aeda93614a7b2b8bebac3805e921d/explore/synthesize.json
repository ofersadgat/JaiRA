              "stance",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "stance": {
                "type": "string"
              },
              "is_mandatory": {
                "type": "boolean"
              },
              "content": {
                "type": "string"
              },
              "holds_earlier_fixed": {
                "type": "boolean"
              },
              "has_irreversible": {
                "type": "boolean"
              }
            }
          },
          "composite_score": {
            "type": "object",
