      },
      "name": "near_matches"
    }
  },
  "operation": {
    "kind": "prompt",
    "user": "Establish this phase's working set, and answer whether the catalog already covers the subject.\n\nYou are the context state for the **{{.inputs.phase}}** phase.\n\n## The standing docs\n\n{{.inputs.standing}}\n\n## The catalog\n\n{{.inputs.catalog}}\n\n## The subject\n\n{{.inputs.subject}}\n\n## What to do\n\nOpen the catalog index and the standing docs with `read_file`. Open only the catalog entries that could bear on the subject.\n\nAnswer one question: does something in the catalog already cover this, well enough that writing a new one would duplicate it?\n\n## What to produce\n\n`matched`: true when the catalog already covers it.\n\n`match_reason`: one or two sentences. On a yes, what matched. On a no, what was checked and why the nearest entry does not fit.\n\n`working_set`: the paths that bear on this subject, one line each on why.\n\n`near_matches`: the catalog entries considered and rejected, as paths.\n",
    "config": {
      "model": "claude-opus-5"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "matched": {
            "type": "boolean"
          },
          "match_reason": {
            "type": "string"
          },
          "working_set": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "near_matches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "matched",
          "match_reason",
          "working_set",
          "near_matches"
        ]
      }
    }
  },
  "environment": {
    "tools": [
      "read_file"
    ],
    "permissions": {
      "profile": "read-only",
      "tools": {
        "read_file": "allow"
      },
      "scopes": [
        {
          "path": "docs/product/**",
          "tools": {
            "read_file": "allow"
          }
        },
        {
          "path": "docs/_templates/**",
          "tools": {
            "read_file": "allow"
          }
        }
      ]
    }
  },
  "slotMeta": {
    "inputs.phase": {
      "default": "product"
    },
    "inputs.standing": {
      "default": [
        "docs/product/principles.md"
      ]
    },
    "inputs.catalog": {
      "default": [
        "docs/product/index.md"
      ]
    },
    "inputs.subject": {
      "optional": true
    }
  }
}
