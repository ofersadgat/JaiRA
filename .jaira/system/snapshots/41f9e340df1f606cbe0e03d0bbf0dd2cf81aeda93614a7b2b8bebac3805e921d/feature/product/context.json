      "schema": {
        "type": "string"
      }
    },
    "standing": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "catalog": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
