      }
    }
  },
  "scopeSession": null,
  "slotMeta": {
    "inputs.changes": {
      "optional": true
    },
    "inputs.unit_tests": {
      "optional": true
    },
    "inputs.docs_touched": {
      "optional": true
    },
    "inputs.severity_threshold": {
      "default": "significant"
    },
    "inputs.standards_amendment": {
