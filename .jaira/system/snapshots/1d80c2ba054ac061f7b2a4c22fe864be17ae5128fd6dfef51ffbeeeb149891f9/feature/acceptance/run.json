{
  "label": "Run the suite",
  "description": "Run the acceptance tests (feature.md §6 step 4). Host code by way of run_command — a model must not be the thing that reports whether tests passed.\n\nDeliberately NOT --if-present, unlike the doc-tooling states. A missing runner for the acceptance suite is not a non-event: it means nothing was verified, and exiting 0 on that would make `green` say the opposite of what happened. Absent tooling reads as red here, and that is the honest answer.",
  "inputs": {
    "acceptance_tests": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "changes": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "command": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    }
  },
  "outputs": {
    "green": {
      "kind": "json",
      "schema": {
        "type": "boolean"
      },
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.strictEq",
          "input": {
            "left": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "op.member",
                          "input": {
                            "value": {
                              "kind": "json",
                              "binding": {
                                "op": {
                                  "kind": "function",
                                  "functionRef": "context.get",
                                  "input": {
                                    "name": {
                                      "kind": "text",
                                      "binding": {
                                        "text": "operation"
                                      }
                                    }
                                  },
                                  "output": {
                                    "name": "value",
                                    "kind": "json"
                                  }
                                }
                              }
                            },
                            "prop": {
                              "kind": "text",
                              "binding": {
                                "text": "output"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "exitCode"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "right": {
              "kind": "json",
              "binding": {
                "json": 0
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "green"
    },
    "results": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "context.get",
                  "input": {
                    "name": {
                      "kind": "text",
                      "binding": {
                        "text": "operation"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "output"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "results"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "run_command",
    "input": {
      "command": {
        "kind": "text",
        "binding": {
          "text": "npm run test:acceptance"
        }
      }
    },
    "output": {
      "kind": "json",
      "schema": {
        "type": "object",
        "required": [
          "exitCode",
          "stdout",
          "stderr"
        ],
        "properties": {
          "exitCode": {
            "type": "number"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "timedOut": {
            "type": "boolean"
          }
        }
      },
      "name": "result"
    }
  },
  "slotMeta": {
    "inputs.acceptance_tests": {
      "optional": true
    },
    "inputs.changes": {
      "optional": true
    },
    "inputs.command": {
      "default": "npm run test:acceptance"
    }
  }
}
