{
  "label": "Approve flows",
  "description": "Always entered (feature.md §0.6).",
  "inputs": {
    "docs": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      }
    },
    "ask_below": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "score": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "reasons": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "must_ask": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "decision": {
      "kind": "text",
      "schema": {
        "type": "string",
        "enum": [
          "approve",
          "revise"
        ]
      },
      "name": "decision"
    },
    "comments": {
      "kind": "text",
      "schema": {
        "type": "string"
      },
      "name": "comments"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "review_artifact",
    "input": {
      "prompt": {
        "kind": "text",
        "binding": {
          "text": "These are the flows: for each deliverable, the path from intent to value.\n\napprove — UI design starts from these flows.\nrevise — back to draft with your comments.\n\nThe brief carries the recommendation and the reasons that moved it. Say why where you override it."
        }
      },
      "artifact": {
        "kind": "text",
        "binding": {
          "text": "docs"
        }
      },
      "options": {
        "kind": "json",
        "binding": {
          "json": [
            "approve",
            "revise"
          ]
        }
      },
      "comments": {
        "kind": "json",
        "binding": {
          "json": true
        }
      }
    },
    "output": {
      "name": "output",
      "kind": "json"
    }
  },
  "slotMeta": {
    "inputs.docs": {
      "optional": true
    },
    "inputs.score": {
      "optional": true
    },
    "inputs.reasons": {
      "optional": true,
      "description": "Shown instead of the bare number: 0.62 tells a person nothing."
    },
    "inputs.must_ask": {
      "optional": true,
      "description": "Non-empty means ask regardless of score."
    },
    "outputs.comments": {
      "optional": true
    }
  }
}
