{
  "label": "Draft deliverables",
  "description": "Write the product deliverables and their docs (feature.md §1 step 3).",
  "inputs": {
    "issue": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      }
    },
    "framing": {
      "kind": "json",
      "schema": {
        "type": "object"
      }
    },
    "residue": {
      "kind": "json",
      "schema": {
        "type": "object"
      }
    },
    "working_set": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "features": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "features"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "features"
    },
    "feature_docs": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "feature_docs"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "feature_docs"
    },
    "standing_amendment": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "standing_amendment"
              }
