{
  "label": "Critique the unit",
  "description": "One independent pass over the draft, on its own conversation.",
  "inputs": {
    "doc": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      }
    },
    "spec": {
      "kind": "json",
      "schema": {
        "type": "object",
        "required": [
          "id",
          "brief"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The doc id under docs/, e.g. ux/patterns/grouped-list."
          },
          "kind": {
            "type": "string",
            "description": "Which template: pattern | component | surface | unit | contract."
          },
          "brief": {
            "type": "string",
            "description": "What this concept is and what the feature needs from it, in a few sentences."
          }
        }
      }
    },
    "feature": {
      "kind": "json",
      "schema": {
        "type": "object",
        "required": [
          "id",
          "story",
          "importance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "story": {
            "type": "string"
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doc_path": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    },
    "standing": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "templates": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "concept": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    },
    "reuse": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "severity_threshold": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    },
    "prior_findings": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "outputs": {
    "findings": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "findings"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "findings"
    },
    "max_severity": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "max_severity"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "max_severity"
    },
    "max_severity_rank": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "max_severity_rank"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "max_severity_rank"
    },
    "target": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "target"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "target"
    }
  },
  "operation": {
    "kind": "prompt",
    "user": "Judge this {{.inputs.concept}} doc. Structure is checked by the machine; judge coverage, substance and the writing standard.\n\n## The doc\n\n{{.inputs.doc}}\n\n## The concept it was asked to be\n\n{{.inputs.spec}}\n\n## The feature it serves\n\n{{.inputs.feature}}\n\n## What the feature reuses from this layer\n\n{{.inputs.reuse}}\n\n## The standing docs and templates\n\n{{.inputs.standing}}\n\n{{.inputs.templates}}\n\n## Mockups\n\n{{.inputs.mockups}}\n\n## The previous pass\n\n{{.inputs.prior_findings}}\n\nEach carries the draft's disposition. `fixed`: check it. `rejected`: read the note and let it go if it holds. `blocked`: decide whether a person has to answer; if so, `target: ask`.\n\n## What to check\n\n{{.inputs.checks}}\n\nAnd, for every doc:\n\n- It describes one concept, and the concept the plan asked for.\n- Headings state conclusions; the text under them holds only what a builder needs.\n- Nothing names a layer below: no code, no files, no tables, no classes in a product, UX or UI doc; no component names in a UX doc.\n- Nothing is a question, an alternative, or a mention of a draft, a pass or a conversation.\n- Frontmatter links resolve to docs that exist, or to the ids the plan named as new.\n- Departures from the standing docs are stated in a line, or absent.\n\n## What to produce\n\n`findings`: each `{ severity: blocker | significant | minor | note, claim, evidence, target_id }`. `evidence` quotes the doc.\n\n`max_severity` and `max_severity_rank` (blocker 3, significant 2, minor 1, note 0). No findings: `note`, 0.\n\n`target`: `draft` when the concept holds and the execution does not; `upstream` when the plan or an earlier layer is wrong; `ask` when a person has to decide.\n\nA finding costs a pass. Raise only what changes what gets built.\n",
    "config": {
      "model": "claude-opus-5"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "severity",
                "claim"
              ],
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "blocker",
                    "significant",
                    "minor",
                    "note"
                  ]
                },
                "claim": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string"
                }
              }
            }
          },
          "max_severity": {
            "type": "string",
            "enum": [
              "blocker",
              "significant",
              "minor",
              "note"
            ]
          },
          "max_severity_rank": {
            "type": "integer"
          },
          "target": {
            "type": "string",
            "enum": [
              "draft",
              "explore",
              "upstream",
              "ask"
            ]
          }
        },
        "required": [
          "findings",
          "max_severity",
          "max_severity_rank",
          "target"
        ]
      }
    }
  },
  "environment": {
    "session": null,
    "tools": [
      "read_file"
    ],
    "permissions": {
      "profile": "read-only",
      "tools": {
        "read_file": "allow"
      },
      "scopes": [
        {
          "path": "docs/product/**",
          "tools": {
            "read_file": "allow"
          }
        },
        {
          "path": "docs/ux/**",
          "tools": {
            "read_file": "allow"
          }
        },
        {
          "path": "docs/ui/**",
          "tools": {
            "read_file": "allow"
          }
        },
        {
          "path": "docs/engineering/**",
          "tools": {
            "read_file": "allow"
          }
        },
        {
          "path": "docs/_templates/**",
          "tools": {
            "read_file": "allow"
          }
        }
      ]
    }
  },
  "scopeSession": null,
  "slotMeta": {
    "inputs.checks": {
      "description": "This layer's checks, as text."
    },
    "inputs.reuse": {
      "optional": true
    },
    "inputs.severity_threshold": {
      "default": "significant"
    },
    "inputs.prior_findings": {
      "optional": true
    }
  }
}
