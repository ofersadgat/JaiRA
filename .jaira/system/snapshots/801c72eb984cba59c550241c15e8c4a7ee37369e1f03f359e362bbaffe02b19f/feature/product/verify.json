{
  "label": "Verify the features",
  "description": "Always entered: the person verifies this step's work before the run moves on. Whether it parks or resolves on the recommendation is the component's call from the score, the reasons and the viewer's threshold.",
  "inputs": {
    "docs": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      }
    },
    "ask_below": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "score": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "reasons": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "must_ask": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "decision": {
      "kind": "text",
      "schema": {
        "type": "string",
        "enum": [
          "approve",
          "revise",
          "cut"
        ]
      },
      "name": "decision"
    },
    "comments": {
      "kind": "text",
      "schema": {
        "type": "string"
      },
      "name": "comments"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "review_artifact",
    "input": {
      "prompt": {
        "kind": "text",
        "binding": {
          "text": "These are the features the issue decomposes into. Approve them, send them back with what to change, or cut the work.\n\napprove: build starts, one feature at a time.\nrevise: back to the draft with your comments.\ncut: nothing is built."
        }
      },
      "artifact": {
        "kind": "text",
        "binding": {
          "text": "docs"
        }
      },
      "options": {
        "kind": "json",
        "binding": {
          "json": [
            "approve",
            "revise",
            {
              "value": "cut",
              "tone": "danger"
            }
          ]
        }
      },
      "comments": {
        "kind": "json",
        "binding": {
          "json": true
        }
      }
    },
    "output": {
      "name": "output",
      "kind": "json"
    }
  },
  "slotMeta": {
    "inputs.docs": {
      "optional": true
    },
    "inputs.score": {
      "optional": true
    },
    "inputs.reasons": {
      "optional": true,
      "description": "Shown instead of the bare number."
    },
    "inputs.must_ask": {
      "optional": true,
      "description": "Non-empty means ask regardless of score."
    },
    "outputs.comments": {
      "optional": true,
      "description": "What to change, when the answer is revise."
    }
  }
}
