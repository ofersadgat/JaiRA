{
  "label": "Approve the change",
  "description": "Always entered (feature.md §0.6).",
  "inputs": {
    "changes": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "unit_tests": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "docs_touched": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "ask_below": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "score": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "reasons": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "must_ask": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "decision": {
      "kind": "text",
      "schema": {
        "type": "string",
        "enum": [
          "approve",
          "revise"
        ]
      },
      "name": "decision"
    },
    "comments": {
      "kind": "text",
      "schema": {
        "type": "string"
      },
      "name": "comments"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "review_artifact",
    "input": {
      "prompt": {
        "kind": "text",
        "binding": {
          "text": "This is the diff, the unit tests that defend the phase-4 invariants, and the doc edits that landed with them.\n\napprove — acceptance testing starts from this code.\nrevise — back to implement with your comments.\n\nNo assertion encoding an invariant may be edited to make a test pass. If one was, that is a design finding, not an approval."
        }
      },
      "artifact": {
        "kind": "text",
        "binding": {
          "text": "changes"
        }
      },
      "options": {
        "kind": "json",
        "binding": {
          "json": [
            "approve",
            "revise"
          ]
        }
      },
      "comments": {
        "kind": "json",
        "binding": {
          "json": true
        }
      }
    },
    "output": {
      "name": "output",
      "kind": "json"
    }
  },
  "slotMeta": {
    "inputs.changes": {
      "optional": true
    },
    "inputs.unit_tests": {
      "optional": true
    },
    "inputs.docs_touched": {
      "optional": true
    },
    "inputs.score": {
      "optional": true
    },
    "inputs.reasons": {
      "optional": true,
      "description": "Shown instead of the bare number: 0.62 tells a person nothing."
    },
    "inputs.must_ask": {
      "optional": true,
      "description": "Non-empty means ask regardless of score."
    },
    "outputs.comments": {
      "optional": true
    }
  }
}
