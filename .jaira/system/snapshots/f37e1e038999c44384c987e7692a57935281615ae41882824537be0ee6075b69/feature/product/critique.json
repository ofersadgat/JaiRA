  "environment": {
    "tools": [
      "read_file"
    ]
  },
  "slotMeta": {
    "inputs.features": {
      "optional": true
    },
    "inputs.feature_docs": {
      "optional": true
    },
    "inputs.severity_threshold": {
      "description": "Substantial means at or above this."
    },
    "inputs.prior_findings": {
      "optional": true,
      "description": "The previous pass's findings, so the loop converges instead of rediscovering the same weakness."
    },
    "inputs.working_set": {
      "optional": true,
      "description": "Paths to the docs this phase reads — its standing docs and the catalog entries that bear on the feature. Open them with read_file: the file as it is now, not a copy taken before this phase started editing."
    }
  }
