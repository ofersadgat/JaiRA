{
  "label": "Write acceptance tests",
  "description": "One test per deliverable, walking the flow's steps, asserting the SUCCESS SIGNAL — not mocking the thing under test (feature.md §6 step 3). A coding agent. ONE TURN in this phase’s conversation: the prompt arrives already rendered, from whichever transition sent control here, so this state declares no per-arrival slots. What it still owns is the OUTPUT CONTRACT — the shape every arrival is held to — and the session that makes the conversation the accumulator.",
  "inputs": {
    "prompt": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      }
    }
  },
  "outputs": {
    "acceptance_tests": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "acceptance_tests"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "acceptance_tests"
    },
    "responses": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "responses"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "responses"
    }
  },
  "operation": {
    "kind": "prompt",
    "user": "{{.inputs.prompt}}",
    "config": {
      "model": "claude-cli/default"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "acceptance_tests": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "severity",
                "claim",
                "disposition"
              ],
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "blocker",
                    "significant",
                    "minor",
                    "note"
                  ]
                },
                "claim": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string",
                  "description": "The deliverable, flow, component or unit id this is about."
                },
                "disposition": {
                  "type": "string",
                  "enum": [
                    "fixed",
                    "rejected",
                    "blocked"
                  ],
                  "description": "fixed: this pass changed to answer it. rejected: the finding is wrong, and `note` says why. blocked: this pass cannot see how to make progress on it — `note` says what it would need."
                },
                "note": {
                  "type": "string",
                  "description": "What changed, why the finding is wrong, or what is missing. Required for rejected and blocked."
                }
              }
            }
          }
        },
        "required": [
          "acceptance_tests"
        ]
      }
    }
  },
  "environment": {
    "session": {
      "name": "acceptance-write",
      "in": "feature/acceptance"
    }
  },
  "scopeSession": {
    "name": "acceptance-write",
    "in": "feature/acceptance"
  },
  "slotMeta": {
    "inputs.prompt": {
      "description": "The turn to append, rendered by `renderTemplate` at the call site that sent control here. Replaces the per-arrival slots this state used to declare (claims, flows, covered, map, prior_findings, returned_findings, reviewer_comments): each is either already in this conversation or is an argument to one of the turns under $BASE/prompts/feature/acceptance/turns/."
    },
    "outputs.responses": {
      "optional": true,
      "description": "One entry per prior finding, saying what this pass did with it. Feeds the critique so it can tell an addressed finding from a restated one — the loop's only memory of its own passes."
    }
  }
}
