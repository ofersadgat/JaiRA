  "operation": {
    "kind": "prompt",
    "user": "{{.inputs.prompt}}",
    "config": {
      "model": "claude-opus-5"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "story",
                "importance",
                "metrics"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "story": {
                  "type": "string",
                  "description": "As a [who], I should be able to [what] so that I can [value]."
                },
                "importance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requires": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "feature_docs": {
            "type": "string",
            "contentMediaType": "text/markdown"
          },
          "standing_amendment": {
            "type": "string",
            "contentMediaType": "text/markdown"
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "severity",
                "claim",
                "disposition"
              ],
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "blocker",
                    "significant",
                    "minor",
                    "note"
                  ]
                },
                "claim": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string",
                  "description": "The deliverable, flow, component or unit id this is about."
                },
                "disposition": {
                  "type": "string",
                  "enum": [
                    "fixed",
                    "rejected",
                    "blocked"
                  ],
                  "description": "fixed: the draft changed to answer it. rejected: the finding is wrong, and `note` says why. blocked: the draft cannot see how to make progress on it — `note` says what it would need."
                },
                "note": {
                  "type": "string",
                  "description": "What changed, why the finding is wrong, or what is missing. Required for rejected and blocked."
                }
              }
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "label"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "A stable id for this question, `<feature-id>__<slug>`. The answer comes back on this key."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "enum"
                  ],
                  "description": "`enum` where the answers are a named set — which is most product questions. `string` with `multiline` only where the answer is genuinely prose."
                },
                "label": {
                  "type": "string",
                  "description": "The question, as the person reads it. One sentence, ending in a question mark."
                },
                "description": {
                  "type": "string",
                  "description": "Why it matters and what each answer would change — two sentences at most. This is what makes the question answerable without reading the spec."
                },
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "optional": {
                  "type": "boolean",
                  "description": "Always true. A person who has no view must be able to submit."
                },
                "multiline": {
                  "type": "boolean"
                },
                "default": {
                  "description": "The reading the draft took. Answering is then confirming or overruling, not composing."
                }
              }
            }
          },
          "doc_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "features",
          "feature_docs"
        ]
      }
    }
  },
  "environment": {
    "session": {
      "name": "product-draft",
      "in": "feature/product"
    },
    "tools": [
      "read_file"
    ],
    "permissions": {
      "profile": "read-only",
      "tools": {
        "read_file": "allow"
      }
    }
  },
  "scopeSession": {
    "name": "product-draft",
    "in": "feature/product"
  },
  "slotMeta": {
    "inputs.prompt": {
      "description": "The turn to append, rendered by `renderTemplate` at the call site that sent control here: the mount renders `turns/brief.md`, and each transition renders the turn that names why it fired. Everything this state used to declare per-arrival — the issue, the working set, the framing, prior findings, returned findings, reviewer comments, answers, must_ask — is either already in this conversation or is an argument to one of those turns."
    },
    "outputs.standing_amendment": {
      "optional": true
    },
    "outputs.responses": {
      "optional": true,
      "description": "One entry per finding the turn carried, saying what this pass did with it. Feeds the critique so it can check whether a finding was addressed or restated — the loop's only memory of its own passes."
    },
    "outputs.questions": {
      "optional": true,
      "description": "Product questions only a person can settle. Empty means the gate is next; non-empty means they are asked BEFORE the loop spends another pass on them."
    },
    "outputs.doc_paths": {
      "optional": true,
      "description": "One path per entry in `features`, in the same order. The parent compares the two lengths: they are the same list or the draft ran again."
    }
  }
}
