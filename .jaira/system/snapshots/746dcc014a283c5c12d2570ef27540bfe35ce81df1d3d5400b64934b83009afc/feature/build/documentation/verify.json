{
  "label": "Edit the text",
  "description": "The person edits the guide before it is published. Always entered.",
  "inputs": {
    "guides": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      }
    },
    "reference": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "ask_below": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "score": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "reasons": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "must_ask": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "content": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      },
      "name": "content"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "edit_artifact",
    "input": {
      "prompt": {
        "kind": "text",
        "binding": {
          "text": "This is the guide as drafted. Edit it as it should read, then save."
        }
      },
      "source": {
        "kind": "text",
        "binding": {
          "text": "guides"
        }
      }
    },
    "output": {
      "name": "output",
      "kind": "json"
    }
  },
  "slotMeta": {
    "inputs.guides": {
      "optional": true
    },
    "inputs.reference": {
      "optional": true
    },
    "inputs.score": {
      "optional": true
    },
    "inputs.reasons": {
      "optional": true
    },
    "inputs.must_ask": {
      "optional": true
    }
  }
}
