{
  "label": "Ship, revise, or drop",
  "description": "Always entered: the person verifies this step's work before the run moves on. Whether it parks or resolves on the recommendation is the component's call from the score, the reasons and the viewer's threshold.",
  "inputs": {
    "findings": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "disposition": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    },
    "failing_layer": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    },
    "ask_below": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "score": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "reasons": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "must_ask": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "decision": {
      "kind": "text",
      "schema": {
        "type": "string",
        "enum": [
          "ship",
          "revise",
          "drop"
        ]
      },
      "name": "decision"
    },
    "comments": {
      "kind": "text",
      "schema": {
        "type": "string"
      },
      "name": "comments"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "choose_option",
    "input": {
      "prompt": {
        "kind": "text",
        "binding": {
          "text": "These are the review's findings and its recommended disposition. ship: the feature is done. revise: the build re-enters the failing layer with these findings. drop: the feature is abandoned."
        }
      },
      "options": {
        "kind": "json",
        "binding": {
          "json": [
            "ship",
            "revise",
            {
              "value": "drop",
              "tone": "danger"
            }
          ]
        }
      },
      "comments": {
        "kind": "json",
        "binding": {
          "json": true
        }
      }
    },
    "output": {
      "name": "output",
      "kind": "json"
    }
  },
  "slotMeta": {
    "inputs.findings": {
      "optional": true
    },
    "inputs.disposition": {
      "optional": true
    },
    "inputs.failing_layer": {
      "optional": true
    },
    "inputs.score": {
      "optional": true
    },
    "inputs.reasons": {
      "optional": true,
      "description": "Shown instead of the bare number."
    },
    "inputs.must_ask": {
      "optional": true,
      "description": "Non-empty means ask regardless of score."
    },
    "outputs.comments": {
      "optional": true,
      "description": "What to change, when the answer is revise."
    }
  }
}
