{
  "label": "Correct what was wrong",
  "description": "Applies the accepted findings that are edits to docs, and records the rest.",
  "inputs": {
    "findings": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "disposition": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    },
    "verdict": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    }
  },
  "outputs": {
    "corrections": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "corrections"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "corrections"
    },
    "paths": {
      "kind": "json",
      "binding": {
        "op": {
          "kind": "function",
          "functionRef": "op.member",
          "input": {
            "value": {
              "kind": "json",
              "binding": {
                "op": {
                  "kind": "function",
                  "functionRef": "op.member",
                  "input": {
                    "value": {
                      "kind": "json",
                      "binding": {
                        "op": {
                          "kind": "function",
                          "functionRef": "context.get",
                          "input": {
                            "name": {
                              "kind": "text",
                              "binding": {
                                "text": "operation"
                              }
                            }
                          },
                          "output": {
                            "name": "value",
                            "kind": "json"
                          }
                        }
                      }
                    },
                    "prop": {
                      "kind": "text",
                      "binding": {
                        "text": "output"
                      }
                    }
                  },
                  "output": {
                    "name": "value",
                    "kind": "json"
                  }
                }
              }
            },
            "prop": {
              "kind": "text",
              "binding": {
                "text": "paths"
              }
            }
          },
          "output": {
            "name": "value",
            "kind": "json"
          }
        }
      },
      "name": "paths"
    }
  },
  "operation": {
    "kind": "prompt",
    "user": "Apply the review's corrections.\n\n## The findings\n\n{{.inputs.findings}}\n\n## The disposition and the verdict\n\n{{.inputs.disposition}}\n\n{{.inputs.verdict}}\n\nOn `ship`: apply every finding that is an edit to a doc, and mark the feature's docs `status: shipped`. On anything else: change nothing and report what you would have changed.\n\n## What to produce\n\n`corrections`: one row per edit: `{ path, was, now }`.\n\n`paths`: every doc edited.\n",
    "config": {
      "model": "claude-cli/default"
    },
    "input": {},
    "output": {
      "name": "output",
      "kind": "json",
      "schema": {
        "type": "object",
        "properties": {
          "corrections": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "corrections",
          "paths"
        ]
      }
    }
  },
  "environment": {
    "tools": [
      "read_file",
      "write_file"
    ]
  },
  "slotMeta": {
    "inputs.findings": {
      "optional": true
    },
    "inputs.disposition": {
      "optional": true
    },
    "inputs.verdict": {
      "optional": true
    }
  }
}
