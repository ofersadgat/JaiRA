{
  "label": "Ship, revise, or drop",
  "description": "The workflow's verdict. `revise` returns to failing_layer at the root; `drop` and `ship` both terminate, and the difference is what dispose recorded. The multi-select over which findings to accept now is the §0.7 contract amendment.",
  "inputs": {
    "findings": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "disposition": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "failing_layer": {
      "kind": "text",
      "schema": {
        "type": "string"
      }
    },
    "ask_below": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "score": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "reasons": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "must_ask": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "decision": {
      "kind": "text",
      "schema": {
        "type": "string",
        "enum": [
          "ship",
          "revise",
          "drop"
        ]
      },
      "name": "decision"
    },
    "accepted": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "name": "accepted"
    },
    "comments": {
      "kind": "text",
      "schema": {
        "type": "string"
      },
      "name": "comments"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "choose_option",
    "input": {
      "prompt": {
        "kind": "text",
        "binding": {
          "text": "This is the review: one verdict per layer, the merged findings from both lenses, and every deliverable disposed as shipped, cut or reduced.\n\nship — the feature is done.\nrevise — back to the failing layer, a fresh instance of that phase.\ndrop — nothing here ships; what was learned is in the disposition.\n\nName in the comments which findings you accept now and which become follow-ups."
        }
      },
      "options": {
        "kind": "json",
        "binding": {
          "json": [
            "ship",
            "revise",
            {
              "value": "drop",
              "tone": "danger"
            }
          ]
        }
      },
      "comments": {
        "kind": "json",
        "binding": {
          "json": true
        }
      }
    },
    "output": {
      "name": "output",
      "kind": "json"
    }
  },
  "slotMeta": {
    "inputs.failing_layer": {
      "optional": true
    },
    "inputs.score": {
      "optional": true
    },
    "inputs.reasons": {
      "optional": true,
      "description": "Shown instead of the bare number: 0.62 tells a person nothing."
    },
    "inputs.must_ask": {
      "optional": true,
      "description": "Non-empty means ask regardless of score."
    },
    "outputs.accepted": {
      "optional": true,
      "description": "Which findings are accepted now rather than becoming follow-ups. Arrives only once the select_many component of §0.7 lands; until then the comments carry it."
    },
    "outputs.comments": {
      "optional": true
    }
  }
}
