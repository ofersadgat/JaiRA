    "inputs.max_severity_rank": {
      "default": 0,
      "description": "blocker=3 … note=0. Absent where the phase has no critique state."
    },
    "inputs.threshold_rank": {
      "default": 2
    },
    "inputs.iteration": {
      "default": 0,
      "description": "Converging on pass 3 is not converging."
    },
    "inputs.max_iterations": {
      "default": 3
    },
    "inputs.runner_up_margin": {
      "default": 1,
      "description": "Winner minus runner-up. Defaults to 1 — no margin pressure — where no exploration ran."
    },
    "inputs.mandatory_margin": {
      "default": 1,
      "description": "Winner minus the do-nothing / reuse candidate."
    },
    "inputs.target": {
      "default": "draft"
    },
    "inputs.has_irreversible": {
      "default": false
    },
    "inputs.has_amendment": {
      "default": false
    },
    "inputs.ask_below": {
      "default": 0.8,
      "description": "Passed through to the gate; this state does not apply it."
    },
    "inputs.phase": {
      "default": "implementation"
    },
    "outputs.score": {
      "description": "0..1. Computed, never claimed."
    },
    "outputs.reasons": {
      "description": "What moved the score, in words. The gate shows these; it never shows the bare number."
    },
    "outputs.must_ask": {
      "description": "Non-empty overrides the threshold: a person is asked whatever the score says."
    }
  }
