{
  "label": "Edit the text",
  "description": "edit_artifact, not review_artifact — copy is the one artifact where the reviewer's own words are faster than a round of revision (feature.md §7).",
  "inputs": {
    "guides": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "reference": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "ask_below": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "score": {
      "kind": "json",
      "schema": {
        "type": "number"
      }
    },
    "reasons": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "must_ask": {
      "kind": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "content": {
      "kind": "blob",
      "schema": {
        "type": "string",
        "contentMediaType": "text/markdown"
      },
      "name": "content"
    }
  },
  "operation": {
    "kind": "function",
    "functionRef": "edit_artifact",
    "input": {
      "prompt": {
        "kind": "text",
        "binding": {
          "text": "This is the audience-facing writing. Edit it directly rather than sending it back — the first ten lines are what get a reader unstuck, and they are quicker to write than to describe."
        }
      },
      "source": {
        "kind": "text",
        "binding": {
          "text": "guides"
        }
      }
    },
    "output": {
      "name": "output",
      "kind": "json"
    }
  },
  "slotMeta": {
    "inputs.guides": {
      "optional": true
    },
    "inputs.reference": {
      "optional": true
    },
    "inputs.score": {
      "optional": true
    },
    "inputs.reasons": {
      "optional": true,
      "description": "Shown instead of the bare number: 0.62 tells a person nothing."
    },
    "inputs.must_ask": {
      "optional": true,
      "description": "Non-empty means ask regardless of score."
    },
    "outputs.content": {
      "description": "What the person actually wrote. edit_artifact returns {content}, so that is the name here; the phase re-exports it as final_text."
    }
  }
}
