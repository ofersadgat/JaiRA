{
  "name": "jaira",
  "private": true,
  "version": "0.1.0",
  "description": "JaiRA: interactive agent-orchestration app on top of declarative-ai (hierarchical workflows with humans in the loop).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/persistence && tsc --noEmit -p packages/runtime && tsc --noEmit -p packages/service && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/app && tsc --noEmit -p packages/client",
    "pretest": "npm run cli:build",
    "test": "vitest run",
    "pretest:watch": "npm run cli:build",
    "test:watch": "vitest",
    "jaira": "tsx packages/cli/src/main.ts",
    "cli:build": "npm --workspace @jaira/cli run build",
    "start": "npm --workspace @jaira/app run start",
    "app": "npm --workspace @jaira/app run start",
    "app:build": "npm --workspace @jaira/app run build",
    "app:dist": "npm --workspace @jaira/app run dist",
    "release-major-version": "node scripts/release/bump.mjs major",
    "release-minor-version": "node scripts/release/bump.mjs minor",
    "release-patch-version": "node scripts/release/bump.mjs patch",
    "release-nightly-version": "node scripts/release/bump.mjs nightly",
    "licenses:sync": "tsx packages/app/licenses/sync.ts",
    "schemas:sync": "node packages/shared/scripts/vendorSchemas.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
