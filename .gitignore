node_modules/
dist/
dist-island/
# Installers and unpacked apps from `npm run app:dist` (packages/app/package.mjs).
packages/app/release/
*.tsbuildinfo

# Secrets. Provider keys live in the environment (see README) — never in a commit.
.env
.env.*
!.env.example

# Pictures of the running app, and the scratch project they are taken in, both regenerated by
# `npm --workspace @jaira/app run shots`. Evidence for a comparison, not an artifact of the build —
# a committed PNG goes stale the first time a hairline moves, and the world is rebuilt every run.
packages/app/shots/out/
packages/app/shots/parity/
# The desktop page's reference pictures (`pair.mts --freeze`, decision 0015): some 1,300 PNGs of one
# studio's world, kept out of the history until it is decided where they live.
packages/app/shots/goldens/
packages/app/shots/.world*/
# The same, for the scratch TypeScript project `verifyTypeCheck.mts` builds to check itself against.
packages/app/shots/.verify/
# Expo's and One's generated state in the client (decision 0015): the dev server's cache and typed routes.
packages/client/.expo/
packages/client/app/routes.d.ts
packages/client/.native-graph/
# The native projects `one prebuild` generates from app.json and the plugins (decision 0015): output, not source.
packages/client/android/
packages/client/ios/
# Copiers' scratch rigs beside the shots (decision 0015): dotfiles, never the rigs themselves.
packages/app/shots/.*.mts
packages/app/shots/.*.mjs
packages/app/shots/.*.txt
